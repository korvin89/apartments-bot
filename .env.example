# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat id (the group shared with your partner). Add the bot to the group and send /start, it replies with the id
TELEGRAM_CHAT_ID=
# How often to poll the sites
POLL_INTERVAL_MINUTES=10
DB_PATH=./data/listings.db
# On the very first run the database is empty, so every listing would count as "new".
# false = the first run posts one overview of what matches now; true = a card per listing
NOTIFY_ON_FIRST_RUN=false
# Post a warning to the chat after this many failed polls in a row (3 x 10 min = 30 min)
HEALTH_ALERT_AFTER=3
# halooglasi.com is behind Cloudflare; it is fetched through curl-impersonate
# (github.com/lexiforest/curl-impersonate/releases). Without the binary the source is skipped.
CURL_IMPERSONATE=./bin/curl-impersonate
# Log files: one per day in LOG_DIR, older than LOG_RETENTION_DAYS are deleted
LOG_DIR=./logs
LOG_RETENTION_DAYS=14
